import os
import torch
from datasets import load_dataset
from transformers import (
    AutoModelForCausalLM,
    AutoTokenizer,
    BitsAndBytesConfig,
)
from peft import LoraConfig, get_peft_model, prepare_model_for_kbit_training
from trl import SFTTrainer, SFTConfig

# ─────────────────────────────────────────────
# CONFIG
# ─────────────────────────────────────────────
MODEL_ID     = "meta-llama/Llama-3.2-1B-Instruct"
DATASET_PATH = "/home/Dataset/medical_sft.jsonl"
OUTPUT_DIR   = "/home/Fine Tuning Files"

# ─────────────────────────────────────────────
# LOAD TOKENIZER
# ─────────────────────────────────────────────
print("Loading tokenizer...")
tokenizer = AutoTokenizer.from_pretrained(MODEL_ID)
tokenizer.pad_token = tokenizer.eos_token
tokenizer.padding_side = "right"

# ─────────────────────────────────────────────
# LOAD FULL DATASET
# ─────────────────────────────────────────────
print("Loading full dataset...")
dataset = load_dataset("json", data_files=DATASET_PATH, split="train")
dataset = dataset.shuffle(seed=42)
print(f"Total samples: {len(dataset)}")

dataset = dataset.train_test_split(test_size=0.02, seed=42)
train_dataset = dataset["train"]
eval_dataset  = dataset["test"]
print(f"Train: {len(train_dataset)} | Eval: {len(eval_dataset)}")

# ─────────────────────────────────────────────
# FORMAT TO LLAMA 3.2 CHAT TEMPLATE
# ─────────────────────────────────────────────
def format_sample(sample):
    text = tokenizer.apply_chat_template(
        sample["messages"],
        tokenize=False,
        add_generation_prompt=False
    )
    return {"text": text}

print("Applying chat template...")
train_dataset = train_dataset.map(
    format_sample,
    remove_columns=["messages"],
    num_proc=4,
    desc="Formatting train"
)
eval_dataset = eval_dataset.map(
    format_sample,
    remove_columns=["messages"],
    num_proc=4,
    desc="Formatting eval"
)

# ─────────────────────────────────────────────
# QUANTIZATION CONFIG
# ─────────────────────────────────────────────
bnb_config = BitsAndBytesConfig(
    load_in_4bit=True,
    bnb_4bit_quant_type="nf4",
    bnb_4bit_compute_dtype=torch.bfloat16,
    bnb_4bit_use_double_quant=True,
)

# ─────────────────────────────────────────────
# LOAD MODEL
# ─────────────────────────────────────────────
print("Loading model...")
model = AutoModelForCausalLM.from_pretrained(
    MODEL_ID,
    quantization_config=bnb_config,
    device_map="auto",
    torch_dtype=torch.bfloat16,
)
model = prepare_model_for_kbit_training(
    model,
    use_gradient_checkpointing=True,
    gradient_checkpointing_kwargs={"use_reentrant": False}  # kills the warning
)
model.config.use_cache = False

# ─────────────────────────────────────────────
# LORA CONFIG
# ─────────────────────────────────────────────
lora_config = LoraConfig(
    r=8,
    lora_alpha=16,
    target_modules=[
        "q_proj", "k_proj", "v_proj", "o_proj",
        "gate_proj", "up_proj", "down_proj"
    ],
    lora_dropout=0.05,
    bias="none",
    task_type="CAUSAL_LM",
)

model = get_peft_model(model, lora_config)
model.print_trainable_parameters()

# ─────────────────────────────────────────────
# SFT CONFIG
# ─────────────────────────────────────────────
sft_config = SFTConfig(
    output_dir=OUTPUT_DIR,

    per_device_train_batch_size=8,      # Reduced to avoid OOM without packing
    per_device_eval_batch_size=8,
    gradient_accumulation_steps=4,      # Keep effective batch = 32
    gradient_checkpointing=True,
    gradient_checkpointing_kwargs={"use_reentrant": False},

    num_train_epochs=1,

    learning_rate=2e-4,
    lr_scheduler_type="cosine",
    warmup_ratio=0.05,

    bf16=True,
    tf32=True,

    logging_steps=100,
    logging_dir=os.path.join(OUTPUT_DIR, "logs"),

    eval_strategy="steps",
    eval_steps=500,

    save_strategy="steps",
    save_steps=500,
    save_total_limit=3,
    load_best_model_at_end=True,
    metric_for_best_model="eval_loss",

    dataloader_num_workers=4,
    dataloader_pin_memory=True,
    optim="paged_adamw_8bit",
    max_grad_norm=0.3,
    group_by_length=True,               # Groups similar lengths = less padding
    report_to="none",
    seed=42,

    # KEY CHANGES
    dataset_text_field="text",
    max_seq_length=512,                 # Reduced from 1024 → big speed boost
    packing=False,                      # Disabled → no more slow packing step
)

# ─────────────────────────────────────────────
# TRAINER
# ─────────────────────────────────────────────
trainer = SFTTrainer(
    model=model,
    args=sft_config,
    train_dataset=train_dataset,
    eval_dataset=eval_dataset,
    tokenizer=tokenizer,
)

# ─────────────────────────────────────────────
# TRAIN
# ─────────────────────────────────────────────
print("\n🚀 Starting full fine-tuning on 204k samples...")
print("⏱️  Estimated time: ~4-5 hours on H20\n")
trainer.train()

# ─────────────────────────────────────────────
# SAVE FINAL MODEL
# ─────────────────────────────────────────────
print("\n💾 Saving final model...")
final_path = os.path.join(OUTPUT_DIR, "final_model")
trainer.save_model(final_path)
tokenizer.save_pretrained(final_path)
print(f"✅ Model saved to: {final_path}")
print("🎉 Fine-tuning complete!")
